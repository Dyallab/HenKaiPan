---
import Layout from "@layouts/Layout.astro";
---

<Layout title="Sign in — HenKaiPan">
    <div class="min-h-screen flex items-center justify-center px-4 bg-background">
        <div class="w-full max-w-sm">
            <div class="text-center mb-8">
                <div class="inline-flex items-center gap-2.5 mb-3">
                    <div class="w-9 h-9 rounded-lg flex items-center justify-center bg-white/5 border border-white/10">
                        <span class="material-symbols-outlined ms-fill text-iridescent-glow text-xl">security</span>
                    </div>
                    <span class="font-aeonik font-light tracking-tight text-ghost-white text-2xl">HenKaiPan</span>
                </div>
                <p class="text-iron-slate text-sm">Sign in to your dashboard</p>
            </div>

            <div class="bg-shadow-tint border border-white/10 rounded-lg p-8">
                <div id="sso-button-container" class="mb-5">
                    <button
                        id="sso-button"
                        type="button"
                        class="w-full flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-ghost-white font-medium py-3 rounded-lg transition-all text-sm"
                    >
                        <span class="material-symbols-outlined text-xl">login</span>
                        Sign in with SSO
                    </button>
                    <div class="flex items-center gap-3 my-4">
                        <div class="flex-1 h-px bg-white/10"></div>
                        <span class="text-xs text-iron-slate uppercase tracking-wider">or</span>
                        <div class="flex-1 h-px bg-white/10"></div>
                    </div>
                </div>
                <form id="login-form" class="space-y-5">
                    <div>
                        <label class="block text-xs font-medium uppercase tracking-wider text-iron-slate mb-2">Username</label>
                        <input
                            id="username"
                            type="text"
                            class="w-full bg-deep-space border border-white/10 text-ghost-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-iridescent-glow focus:ring-1 focus:ring-iridescent-glow transition-colors"
                        />
                    </div>
                    <div>
                        <label class="block text-xs font-medium uppercase tracking-wider text-iron-slate mb-2">Password</label>
                        <input
                            id="password"
                            type="password"
                            class="w-full bg-deep-space border border-white/10 text-ghost-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-iridescent-glow focus:ring-1 focus:ring-iridescent-glow transition-colors"
                        />
                    </div>
                    <button
                        type="submit"
                        id="submit-btn"
                        class="w-full bg-primary hover:bg-primary-fixed-dim text-on-primary font-medium py-3 rounded-lg transition-all text-sm uppercase tracking-widest disabled:opacity-50 disabled:cursor-not-allowed"
                    >
                        Sign in
                    </button>
                </form>
            </div>
        </div>
    </div>

    <script>
        import { API_BASE, api } from "@lib/api";
        import { toast } from "@lib/toast";

        (async () => {
            try {
                const res = await fetch(`${API_BASE}/api/me`, { credentials: "include" });
                if (!res.ok) return;
                window.location.href = "/dashboard";
            } catch (err) {
                console.error("Auth check error:", err);
            }
        })();

        (async () => {
            const btn = document.getElementById("sso-button") as HTMLButtonElement;
            let ssoEnabled = false;
            try {
                const { enabled } = await api.getSSOStatus();
                ssoEnabled = enabled;
            } catch {
                // SSO status unavailable — treat as disabled
            }

            btn.addEventListener("click", () => {
                if (ssoEnabled) {
                    window.location.href = "/api/auth/sso/login";
                } else {
                    toast("SSO is not enabled for this deployment.", "info");
                }
            });
        })();

        const ssoError = new URLSearchParams(window.location.search).get("error");
        if (ssoError) {
            const messages: Record<string, string> = {
                sso_failed: "SSO login failed. Please try again or contact your administrator.",
                sso_no_email: "SSO provider did not return an email address. Contact your administrator.",
                sso_error: "An error occurred during SSO login. Please try again.",
            };
            toast(messages[ssoError] ?? "SSO login error.", "error");
        }

        document.getElementById("login-form")!.addEventListener("submit", async (e) => {
            e.preventDefault();
            const btn = document.getElementById("submit-btn") as HTMLButtonElement;
            const username = (document.getElementById("username") as HTMLInputElement).value;
            const password = (document.getElementById("password") as HTMLInputElement).value;

            btn.disabled = true;
            const originalText = btn.textContent;
            btn.textContent = "Signing in...";

            try {
                const res = await fetch(`${API_BASE}/api/auth/login`, {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ username, password }),
                });

                const data = await res.json();

                if (!res.ok) {
                    toast(data.error || `Login failed (${res.status})`, "error");
                    return;
                }

                toast(`Welcome back, ${data.username}!`, "success");
                setTimeout(() => { window.location.href = "/dashboard"; }, 500);
            } catch (err: any) {
                toast(`Error: ${err?.message || "Connection error. Check that the API server is running."}`, "error");
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    </script>
</Layout>
